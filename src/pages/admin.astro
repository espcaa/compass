---
import BaseLayout from "../layouts/base.astro";
import AdminDashboard from "../components/admin/dashboard.astro";
import { GetAllProjects, GetAllUsers } from "../components/admin/utils";

const users = GetAllUsers();
const projects = GetAllProjects();
---

<BaseLayout title="Admin" hideFooter={true}>
    <AdminDashboard users={users} projects={projects} />
</BaseLayout>
