---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/base.astro";
import "../../../styles/home.css";
import "../../../styles/project.css";
import { GetUserFromCookies } from "../../../utils/auth.ts";
import amazeImg from "../../../assets/images/amaze.jpg";

const user = await GetUserFromCookies(Astro.cookies);
if (!user) return Astro.redirect("/login");
if (!user.hackatimeLinked) return Astro.redirect("/station/link");
---

<BaseLayout title="Create Project" hideFooter={true}>
    <div class="separated-container">
        <div class="content-right">
            <h1>new project</h1>
            <form
                method="POST"
                action="/api/create-project"
                class="form"
                enctype="multipart/form-data"
            >
                <div class="form-group">
                    <label for="name">name</label>
                    <input
                        autocomplete="off"
                        type="text"
                        id="name"
                        name="name"
                        required
                    />
                </div>
                <div class="form-group">
                    <label for="description">description</label>
                    <textarea id="description" name="description" required
                    ></textarea>
                </div>
                <div class="form-group">
                    <label for="githubUrl">github url</label>
                    <input
                        type="url"
                        id="githubUrl"
                        name="githubUrl"
                        required
                    />
                </div>
                <div class="form-group">
                    <label for="hackatimeProjects">hackatime projects</label>
                    <input
                        type="text"
                        id="hackatimeProjects"
                        name="hackatimeProjects"
                        required
                    />
                </div>
                <div class="form-group">
                    <label for="image">image url</label>
                    <input
                        type="file"
                        id="image"
                        name="image"
                        accept="image/*"
                    />
                </div>
                <div class="row gap">
                    <a class="button warnbg" href="/station/home">cancel</a>
                    <button type="submit" class="button">create</button>
                </div>
            </form>
        </div>
        <div class="image-left">
            <Image
                src={amazeImg}
                width={700}
                height={1000}
                alt="amaze"
                class="amaze"
            />
        </div>
    </div>
</BaseLayout>
