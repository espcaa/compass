---
export const prerender = false;

import BaseLayout from "../layouts/base.astro";
import Spinner from "../components/Spinner.astro";
import "../styles/callmeback.css";
import { Login } from "../utils/hackclub";

// get the url params
const code = Astro.url.searchParams.get("code");

if (!code) {
    throw new Error("No `code` query parameter present on the callback URL.");
}
// do auth (magic)
var loginResult = await Login(code);
if (!loginResult.ok) {
    // something went wrong ono
    // redirect to error page with error message
    throw new Error(`${loginResult.error}. code was ${code}`);
} else {
    // save the token to cookies :3
    Astro.cookies.set("hackrail_token", loginResult.value, {
        httpOnly: true,
        secure: true,
        sameSite: "strict",
        maxAge: 60 * 60 * 24 * 7, // 1 week ig?
    });
}
---

<BaseLayout title="loading..." hideFooter={true}>
    <div class="callmeback-container">
        <Spinner class="spinner" size={50} />
        <p>Logging you in...</p>
    </div>
</BaseLayout>
