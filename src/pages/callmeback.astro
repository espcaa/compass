---
export const prerender = false;

import "../styles/callmeback.css";
import { Login } from "../utils/hackclub";

// get the url params
const code = Astro.url.searchParams.get("code");

if (!code) {
    return Astro.redirect(`/error?code=missing_code`);
}
// do auth (magic)
const loginResult = await Login(code);
if (!loginResult.ok) {
    // something went wrong ono
    // redirect to error page with error message
    return Astro.redirect(
        `/error?code=auth_failed&message=${loginResult.error.message}`,
    );
} else {
    // save the token to cookies :3
    Astro.cookies.set("hackrail_token", loginResult.value, {
        httpOnly: true,
        secure: true,
        sameSite: "strict",
        maxAge: 60 * 60 * 24 * 7, // 1 week ig?
    });
    return Astro.redirect("/dashboard");
}
---
