---
import "./silycarousel.css";
import { Image } from "astro:assets";

type Direction = "up" | "right";

export type Card = {
    image: ImageMetadata;
    alt: string;
    title: string;
};
interface Props {
    cards: Card[];
    direction: Direction;
}

const { cards, direction } = Astro.props;
const count = cards.length;
const copies = 4;
const cardWidth = 316;
const cardHeight = 266.4;
const duration = `${Math.max(count * 2, 12)}s`;
const distance = `${-(count * cardWidth)}px`;
const repeated = Array.from({ length: copies }, () => cards).flat();
---

<div class="carousel" data-direction={direction}>
    <div
        class="track"
        style={direction === "up"
            ? `--distanceX: 0px; --distanceY: ${distance}; --duration: ${duration};`
            : `--distanceX: ${distance}; --distanceY: 0px; --duration: ${duration};`}
    >
        {
            repeated.map((slide, i) => (
                <div class="slide" aria-hidden={i >= count}>
                    <Image
                        src={slide.image}
                        alt={slide.alt}
                        class="slide-image"
                    />
                    <div class="slide-content">
                        <h2 class="slide-title">{slide.title}</h2>
                    </div>
                </div>
            ))
        }
    </div>
</div>
