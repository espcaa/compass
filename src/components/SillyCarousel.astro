---
import "./silycarousel.css";
import { Image } from "astro:assets";

type Direction = "up" | "right";

export type Card = {
    image: ImageMetadata;
    alt: string;
    title: string;
    description?: string;
};
interface Props {
    cards: Card[];
    direction: Direction;
    ideas: boolean;
}

const { cards, direction } = Astro.props;
const count = cards.length;
const copies = 4;
const cardWidth = 316;
const cardHeight = 303.99;
const duration = `${Math.max(count * 2, 12)}s`;
const distanceX = `${-(count * cardWidth)}px`;
const distanceY = `${-(count * cardHeight)}px`;
const repeated = Array.from({ length: copies }, () => cards).flat();
---

<div
    class="carousel"
    data-direction={direction}
    data-ideas={Astro.props.ideas ? "true" : "false"}
>
    <div
        class="track"
        style={direction === "up"
            ? `--distanceX: 0px; --distanceY: ${distanceY}; --duration: ${duration};`
            : `--distanceX: ${distanceX}; --distanceY: 0px; --duration: ${duration};`}
    >
        {
            repeated.map((slide, i) => (
                <div class="slide" aria-hidden={i >= count}>
                    <Image
                        src={slide.image}
                        width={cardWidth * 2}
                        alt={slide.alt}
                        class="slide-image"
                    />
                    <div class="slide-content">
                        <h2 class="slide-title">{slide.title}</h2>
                        {slide.description && (
                            <p class="slide-description">{slide.description}</p>
                        )}
                    </div>
                </div>
            ))
        }
    </div>
</div>
