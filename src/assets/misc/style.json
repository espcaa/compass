{
  "version": 8,
  "name": "minimal",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "rail-overlay": {
      "type": "geojson",
      "data": "/rail.json"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#9db09a" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["==", "$type", "Polygon"],
      "paint": { "fill-color": "#26332a", "fill-antialias": false }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 0,
      "filter": ["all", ["==", "$type", "LineString"], ["==", "class", "rail"]],
      "layout": { "line-join": "round", "visibility": "visible" },
      "paint": {
        "line-color": "#7a6f5d",
        "line-width": {
          "base": 1.2,
          "stops": [
            [6, 0.4],
            [16, 2]
          ]
        }
      }
    },
    {
      "id": "rail-overlay",
      "type": "line",
      "source": "rail-overlay",
      "minzoom": 0,
      "maxzoom": 8,
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": "#7a6f5d",
        "line-width": {
          "base": 1.2,
          "stops": [
            [0, 0.4],
            [5, 1.1],
            [7, 1.8]
          ]
        }
      }
    }
  ],
  "id": "minimal-political-rail"
}
